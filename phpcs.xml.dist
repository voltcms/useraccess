<?xml version="1.0"?>
<ruleset name="VoltCMS-UserAccess">
    <description>
        Lightweight coding-standard checks for the UserAccess library. Kept
        intentionally narrow so it enforces the conventions the codebase already
        follows (no tabs, unix line endings, no trailing whitespace, files end in
        a newline, long-form open tags, lowercase keywords) without imposing a
        wholesale reformat. Rules such as short array syntax and no-leading-
        backslash imports are deliberately absent: they are phpcbf-fixable but
        would land as one large diff, so CLAUDE.md keeps them as review guidance.
    </description>

    <file>src</file>
    <file>tests</file>

    <arg name="colors"/>
    <arg value="sp"/>
    <!-- Only errors should fail the build; warnings are advisory. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.Files.ByteOrderMark"/>
    <!-- These three already hold across src/ and tests/; they pin down the
         `CONST` / `TRUE` / `array()` drift the standards pass cleaned up so it
         cannot creep back in. The remaining long-array calls live in demo/,
         which this ruleset does not cover. -->
    <rule ref="Generic.PHP.LowerCaseKeyword"/>
    <rule ref="Generic.PHP.LowerCaseConstant"/>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Generic.Files.LineEndings">
        <properties>
            <property name="eolChar" value="\n"/>
        </properties>
    </rule>
    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <rule ref="PSR2.Files.EndFileNewline"/>
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
        <properties>
            <property name="ignoreBlankLines" value="true"/>
        </properties>
    </rule>
</ruleset>
